{
  "name": "control-room",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch platform/server/main.ts",
    "dev:web": "vite",
    "seed": "tsx platform/server/seed-cli.ts",
    "reset": "tsx platform/server/reset-cli.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "assure": "vitest run --reporter=json --outputFile=evidence/test-results.json"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "cookie-parser": "1.4.7",
    "express": "4.22.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "4.17.21",
    "@types/node": "22.20.4",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/supertest": "6.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "9.1.2",
    "supertest": "7.0.0",
    "tsx": "4.23.14",
    "typescript": "5.7.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.2": true
  }
}
